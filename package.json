{
  "name": "namu-race-online",
  "version": "0.4.2-beta.1",
  "description": "Windows와 macOS에서 함께 플레이하는 온라인 나무위키 링크 레이스",
  "main": "src/main-online.cjs",
  "author": "Namu Race",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main-online.cjs && node --check src/hud-preload-online.cjs && node --check src/wiki-preload.cjs && node --check src/renderer-online.js && node --check src/updater-online.cjs && node --test test/*.test.mjs",
    "server:dev": "wrangler dev --config server/wrangler-final-v2.jsonc",
    "server:deploy": "wrangler deploy --config server/wrangler-final-v2.jsonc",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --universal --publish never"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260902.1",
    "electron": "43.5.1",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "wrangler": "4.128.0"
  },
  "build": {
    "appId": "online.namurace.desktop",
    "productName": "나무레이스 온라인",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "server-url.txt"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "YJH0501",
      "repo": "namu-race-online"
    },
    "win": {
      "icon": "src/assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NamuRace-online-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "mac": {
      "icon": "src/assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": null,
      "hardenedRuntime": false,
      "minimumSystemVersion": "12.0",
      "artifactName": "NamuRace-online-${version}-mac-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
